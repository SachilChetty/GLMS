@model GLMS.Models.ServiceRequest

<h2>Create Service Request</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <label>Select Contract</label>
    <select asp-for="ContractId" class="form-control">
        @if (ViewBag.Contracts != null)
        {
            foreach (var c in ViewBag.Contracts)
            {
                <option value="@c.Id">Contract #@c.Id (@c.Status)</option>
            }
        }
    </select>

    <input asp-for="Description" placeholder="Description" class="form-control" />
    <input type="number" step="0.01" name="usdAmount" placeholder="USD Amount" class="form-control" />

    <button type="submit">Create Request</button>
</form>