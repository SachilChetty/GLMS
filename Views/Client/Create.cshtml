@model GLMS.Models.Client

<h2>Create Client</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="Name" placeholder="Name" class="form-control" />
    <input asp-for="ContactDetails" placeholder="Contact" class="form-control" />
    <input asp-for="Region" placeholder="Region" class="form-control" />

    <button type="submit">Create</button>
</form>