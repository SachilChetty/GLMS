@model IEnumerable<GLMS.Models.Client>
   

<h2>Clients</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add Client</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Contact</th>
            <th>Region</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.Name</td>
                <td>@client.ContactDetails</td>
                <td>@client.Region</td>
            </tr>
        }
    </tbody>
</table>

