@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-5">
    <h1 class="display-4">Welcome to TechMove GLMS</h1>
    <p class="lead">Logistics & Contract Management System</p>
</div>

<div class="row text-center">

    <!-- Clients -->
    <div class="col-md-4 mb-4">
        <div class="card shadow">
            <div class="card-body">
                <h3>Clients</h3>
                <p>Manage company clients</p>
                <a asp-controller="Client" asp-action="Index" class="btn btn-primary">View Clients</a>
            </div>
        </div>
    </div>

    <!-- Contracts -->
    <div class="col-md-4 mb-4">
        <div class="card shadow">
            <div class="card-body">
                <h3>Contracts</h3>
                <p>Create and manage contracts</p>
                <a asp-controller="Contract" asp-action="Index" class="btn btn-success">View Contracts</a>
            </div>
        </div>
    </div>

    <!-- Service Requests -->
    <div class="col-md-4 mb-4">
        <div class="card shadow">
            <div class="card-body">
                <h3>Service Requests</h3>
                <p>Create and track requests</p>
                <a asp-controller="ServiceRequest" asp-action="Create" class="btn btn-warning">Create Request</a>
            </div>
        </div>
    </div>

</div>

<hr />

<div class="text-center mt-4">
    <h4>System Features</h4>
    <p>
        ✔ Client & Contract Management <br />
        ✔ PDF Contract Upload & Download <br />
        ✔ Currency Conversion (USD → ZAR) <br />
        ✔ Workflow Validation (Active Contracts Only) <br />
    </p>
</div>